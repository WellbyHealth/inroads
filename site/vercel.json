{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node tools/blog.mjs",
  "outputDirectory": "public",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "inroad-site.vercel.app"
        }
      ],
      "destination": "https://wellbyinroads.com/",
      "permanent": true
    },
    {
      "source": "/pricing",
      "has": [
        {
          "type": "host",
          "value": "inroad-site.vercel.app"
        }
      ],
      "destination": "https://wellbyinroads.com/pricing",
      "permanent": true
    },
    {
      "source": "/specialties",
      "has": [
        {
          "type": "host",
          "value": "inroad-site.vercel.app"
        }
      ],
      "destination": "https://wellbyinroads.com/specialties",
      "permanent": true
    },
    {
      "source": "/privacy",
      "has": [
        {
          "type": "host",
          "value": "inroad-site.vercel.app"
        }
      ],
      "destination": "https://wellbyinroads.com/privacy",
      "permanent": true
    },
    {
      "source": "/compare/:slug",
      "has": [
        {
          "type": "host",
          "value": "inroad-site.vercel.app"
        }
      ],
      "destination": "https://wellbyinroads.com/compare/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    }
  ]
}
